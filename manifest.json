{
  "manifest_version": "0.3",
  "name": "signwell",
  "display_name": "SignWell",
  "description": "Model Context Protocol server that orchestrates SignWell's e-signature workflows \u2014 create, send, track, and manage documents and templates.",
  "version": "0.3.3",
  "author": {
    "name": "SignWell",
    "url": "https://github.com/Bidsketch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bidsketch/signwell-mcp"
  },
  "homepage": "https://github.com/Bidsketch/signwell-mcp#readme",
  "documentation": "https://github.com/Bidsketch/signwell-mcp#readme",
  "support": "https://github.com/Bidsketch/signwell-mcp/issues",
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "e-signature",
    "esignature",
    "signing",
    "documents",
    "templates",
    "contracts"
  ],
  "server": {
    "type": "node",
    "entry_point": "build/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/build/index.js"
      ],
      "env": {
        "SIGNWELL_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "user_config": {
    "api_key": {
      "title": "SignWell API Key",
      "description": "SignWell API key with document access.",
      "type": "string",
      "required": true,
      "sensitive": true
    }
  },
  "privacy_policies": [
    "https://www.signwell.com/privacy/"
  ]
}
